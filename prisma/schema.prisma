datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Expense {
  id            Int      @id @default(autoincrement())
  date          String
  merchant      String
  amount        Int
  category      String
  taxRate       Int      @default(10)
  invoiceNumber String?
  imageUrl      String?
  note          String?
  status        String   @default("confirmed") // confirmed, pending
  paymentMethod String   @default("credit_card")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  role      String   // user, assistant
  content   String
  category  String?  // year_end_tax, deduction, expense, general
  createdAt DateTime @default(now())
}